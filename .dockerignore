# Keep the build context small and, more importantly, keep secrets and local
# state out of an image that gets pushed to a registry.

.env
.env.*
!.env.example

.git
.gitignore
.pgdata
.storage
venv
.venv
__pycache__
**/__pycache__
*.pyc
.pytest_cache
.ruff_cache
.mypy_cache

# The SPA *is* built into this image (see Dockerfile), so the sources have to
# reach the build context. Only these two are excluded: node_modules is
# installed inside the node stage from the lockfile, and dist is rebuilt there
# — copying either in would ship a stale or host-specific bundle.
frontend/node_modules
frontend/dist

# Tests and their fixtures are not needed at runtime, and the demo PDFs are
# ~2MB of image for no reason — they are re-ingested from the repo, not from
# the container.
tests
demo_papers

HANDOFF.md
architecture.md
README.md
.DS_Store
