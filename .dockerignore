# Keep the build context small and, more importantly, keep secrets and local
# state out of an image that gets pushed to a registry.

.env
.env.*
!.env.example

.git
.gitignore
.pgdata
.storage
venv
.venv
__pycache__
**/__pycache__
*.pyc
.pytest_cache
.ruff_cache
.mypy_cache

# The SPA is deployed separately as a static bundle.
frontend

# Tests and their fixtures are not needed at runtime, and the demo PDFs are
# ~2MB of image for no reason — they are re-ingested from the repo, not from
# the container.
tests
demo_papers

HANDOFF.md
architecture.md
README.md
.DS_Store
