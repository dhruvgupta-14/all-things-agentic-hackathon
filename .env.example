# Configuration. There is one shape and no second mode.
#
# Every value below is required unless marked otherwise, and the process
# refuses to start without them — naming the missing setting rather than
# quietly substituting a local stand-in. Running on localhost changes nothing:
# it is an address, not a mode. The same Firebase project, the same Cloud SQL
# instance, the same bucket and the same queue.
#
# Credentials are never in this file. Application default credentials cover
# Firebase Admin, Vertex, Cloud SQL, Cloud Storage and Cloud Tasks:
#
#     gcloud auth application-default login
#
# On Cloud Run these come from `gcloud run deploy --set-env-vars` (see
# scripts/deploy_cloud_run.sh), and DB_PASSWORD from Secret Manager.

# --- Identity --------------------------------------------------------------
# The Firebase project whose ID tokens this deployment accepts. Verification
# pins each token's audience to it, so a mismatch rejects every login.
FIREBASE_PROJECT_ID=

# --- Database --------------------------------------------------------------
# Cloud SQL, as an instance connection name: project:region:instance. There is
# no host/port alternative — the connector supplies the connection.
CLOUD_SQL_INSTANCE=
CLOUD_SQL_IP_TYPE=PUBLIC
DB_USER=app
DB_PASSWORD=
DB_NAME=paper_companion

# --- Object storage --------------------------------------------------------
# The private bucket uploaded PDFs live in.
STORAGE_BUCKET=

# --- Models ----------------------------------------------------------------
VERTEX_PROJECT=
# `global`, not a region. Gemini 3.x is not served from regional endpoints:
# gemini-3.5-flash returns 404 in us-central1 and only gemini-2.5-flash answers
# there, which silently drops the deployment below HK-1's "Flash-class 3.5+".
# The global endpoint serves gemini-embedding-001 too, so one value covers both.
VERTEX_LOCATION=global

# --- Asynchronous work -----------------------------------------------------
# Ingestion is pushed back to /internal/ingest on this same service, signed
# with an OIDC token minted as SERVICE_ACCOUNT_EMAIL.
CLOUD_TASKS_QUEUE=ingestion
CLOUD_TASKS_LOCATION=us-central1
SERVICE_ACCOUNT_EMAIL=
# This service's own https URL, and the OIDC audience the push route checks
# against. Note that this stays the *deployed* URL even when you are running on
# localhost: a Cloud Tasks push cannot reach your laptop, so a paper uploaded
# from a local run is ingested by the deployed service.
SERVICE_BASE_URL=
# Optional. The project holding the queue; defaults to VERTEX_PROJECT.
GCP_PROJECT=

# --- Frontend --------------------------------------------------------------
# Optional. Where the built SPA is served from, relative to the repository
# root. `npm run build` in frontend/ writes here, and the container image
# builds it to the same path.
SPA_DIST_DIR=frontend/dist

# --- Retrieval -------------------------------------------------------------
RETRIEVAL_TOP_K=8
# Leave blank. Cosine scores are not comparable between embedding models, so
# the embedder carries the floor for its own vector space. Setting a value here
# overrides it.
RETRIEVAL_MIN_SIMILARITY=
