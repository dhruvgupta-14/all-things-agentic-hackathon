APP_ENV=local

DB_USER=app
DB_PASSWORD=app_local_dev_password
DB_NAME=paper_companion
DB_HOST=localhost
DB_PORT=5432

# Firebase project whose ID tokens this deployment accepts. /me and /papers
# return 503 until this is set. Credentials come from ADC — set
# GOOGLE_APPLICATION_CREDENTIALS locally; Cloud Run uses the metadata server.
FIREBASE_PROJECT_ID=

# LOCAL DEVELOPMENT ONLY. When set, every request is authenticated as this
# Firebase subject with no token presented. Only honoured when APP_ENV=local;
# set anywhere else the app returns 503 rather than accepting it. Leave blank
# unless you are working without Firebase credentials.
AUTH_DEV_BYPASS_SUBJECT=

# Gemini API key from Google AI Studio: https://aistudio.google.com/apikey
# Free tier, no billing account required. This is the development path, and it
# selects gemini-embedding-001 + Gemini Flash over the local stubs.
GEMINI_API_KEY=

# Vertex AI. Leave blank for local development: an unset project selects the
# deterministic hashing embedder instead of gemini-embedding-001.
VERTEX_PROJECT=
# `global`, not a region. Gemini 3.x is not served from a regional endpoint:
# gemini-3.5-flash returns 404 in us-central1 and only gemini-2.5-flash answers
# there, which silently drops the deployment below HK-1's "Flash-class 3.5+".
# The global endpoint serves gemini-embedding-001 too, so one value covers both.
VERTEX_LOCATION=global

# Retrieval tuning. Leave RETRIEVAL_MIN_SIMILARITY blank: cosine scores are not
# comparable between embedding models, so each embedder carries the floor for
# its own vector space (0.25 lexical stub, 0.58 gemini-embedding-001). Set it
# only to override both deliberately.
RETRIEVAL_TOP_K=8
RETRIEVAL_MIN_SIMILARITY=

# --------------------------------------------------------------------------
# Deployment only. Every value below is blank for local development, and the
# application takes its local path when they are.
# --------------------------------------------------------------------------

# Cloud SQL as an instance connection name (project:region:instance). Set, it
# switches both engines onto the Cloud SQL connector and DB_HOST/DB_PORT are
# ignored.
CLOUD_SQL_INSTANCE=
CLOUD_SQL_IP_TYPE=PUBLIC

# Private GCS bucket for uploaded PDFs. Unset, uploads go to a local directory
# — which on Cloud Run is ephemeral, so every restart loses them.
STORAGE_BUCKET=

# Cloud Tasks: durable ingestion. All three are required together, and without
# them a *deployed* service refuses uploads rather than running the job
# in-process, because in-process work does not survive Cloud Run reclaiming the
# instance. SERVICE_BASE_URL is this service's own https URL, and doubles as
# the OIDC audience that /internal/ingest checks.
CLOUD_TASKS_QUEUE=
CLOUD_TASKS_LOCATION=us-central1
SERVICE_ACCOUNT_EMAIL=
SERVICE_BASE_URL=

# The project holding the queue. Defaults to VERTEX_PROJECT.
GCP_PROJECT=

# Where the built SPA is served from, relative to the repository root. The
# container image builds it to this path.
SPA_DIST_DIR=frontend/dist
