# The Postgres volume for the test database. The application talks only to
# Cloud SQL; this exists so the suite has a throwaway database to roll back.
.pgdata/

# Left over from the filesystem storage backend, which no longer exists —
# uploaded PDFs go to Cloud Storage. Nothing writes here any more; the
# directory is kept out of git because it holds third-party papers that should
# not be redistributed through this repo. Safe to delete.
.storage/
